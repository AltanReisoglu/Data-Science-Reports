# Copy to pipeline/.env and fill in. That file is gitignored; this one is not.
# Values already exported in the shell win over anything set here.

VC_LLM_BASE_URL="https://mia.csp.kloudeks.com/v1"
VC_LLM_API_KEY=""

# One model serving all three tiers. The tiers exist so a cheap model can do the
# volume and a strong one the memo; with a single endpoint they are the same
# name, and the funnel's cost discipline comes from call counts instead.
VC_MODEL_CHEAP="gemma-4-31B-it"
VC_MODEL_MID="gemma-4-31B-it"
VC_MODEL_STRONG="gemma-4-31B-it"

# Capability declaration — AutoGen believes it. Run `probe_llm.py` and use what
# it measured; a wrong claim here fails at the far end of the funnel, not here.
VC_MODEL_FUNCTION_CALLING=1
VC_MODEL_STRUCTURED_OUTPUT=1
VC_MODEL_JSON_OUTPUT=1
VC_MODEL_FAMILY="unknown"

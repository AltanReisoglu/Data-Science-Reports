# Bu dosyayı .env olarak kopyalayın ve LLM_API_KEY'i doldurun.
# Endpoint OpenAI-uyumlu; openai SDK base_url ile buraya yönlendirilir.
LLM_BASE_URL=https://your-llm-endpoint.example/v1
LLM_API_KEY=
LLM_MODEL_NAME=gemma-4-31B-it

# Trace compaction ayarları
TRACE_TOKEN_BUDGET=4000      # bu eşik aşılınca eviction tetiklenir (token ~ char/4)
TRACE_PROTECT_WINDOW=3       # son N birim asla evict edilmez (koruma penceresi)
